# Configuración de conexión a MongoDB Atlas
# Reemplace únicamente REEMPLAZAR_POR_URI_DE_ATLAS con la URI real del cluster.
# Este archivo se versiona; el archivo .env real se ignora con .gitignore.
MONGODB_URI=REEMPLAZAR_POR_URI_DE_ATLAS
MONGODB_DATABASE=REEMPLAZAR_POR_NOMBRE_DE_BASE_DE_DATOS
MONGODB_PREDICTIONS_COLLECTION=REEMPLAZAR_POR_NOMBRE_DE_COLECCIÓN_DE_PREDICCIONES
MONGODB_TIMEOUT_MS=8000

# Ruta del modelo Keras (permanece en la raíz del repositorio)
MODEL_PATH=modelo_frutas.keras
